{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["cypress", "node"],
    "baseUrl": ".",
    "paths": {
      "@actions/*": ["libs/actions/src/lib/*"],
      "@ui-map/*": ["libs/ui-map/src/lib/*"]
    }
  },
  "include": ["cypress/**/*.ts", "libs/**/*.ts", "cypress.config.ts"]
}
