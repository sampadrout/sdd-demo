{
  "name": "sdd-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Spec-Driven Development demo — Cypress + OpenSpec against ParaBank",
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || >=26.0.0"
  },
  "workspaces": [
    "apps/*",
    "libs/*",
    "tools/cypress-mcp"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "cy:open": "npm run cy:open -w @sdd/parabank-e2e --",
    "cy:run": "npm run cy:run -w @sdd/parabank-e2e --",
    "cy:agent": "npm run cy:agent -w @sdd/parabank-e2e --",
    "cy:tap": "npm run cy:tap -w @sdd/parabank-e2e --",
    "cy:run:parallel": "node scripts/cy-parallel.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run cy:run",
    "openspec": "openspec",
    "context": "npx --yes repomix@latest",
    "context:compress": "npx --yes repomix@latest --compress",
    "mcp:setup": "npm run build -w cypress-mcp && npm exec -w cypress-mcp -- playwright install chromium",
    "mcp:build": "npm run build -w cypress-mcp"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.6.0",
    "@fission-ai/openspec": "~2.2.0",
    "cypress": "^16.4.0",
    "typescript": "^5.8.2"
  }
}
